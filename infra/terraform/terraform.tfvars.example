project_name            = "valueai-mvp"
aws_region              = "us-east-1"
# Set this to the AWS CLI profile for the target account, or leave commented
# to use the default credential chain.
aws_profile            = "rajesh_volluru"
# Optional: assume a deploy role in the target account.
aws_assume_role_arn    = "arn:aws:iam::537595754494:role/jouft_developer"
api_key                 = "replace-me"
container_image         = "537595754494.dkr.ecr.us-east-1.amazonaws.com/valueai-mvp-api:latest"
api_domain_name         = "api.jouft.com"
api_certificate_arn     = ""
create_api_dns_record   = false
route53_zone_id         = ""
cors_allow_origins      = "http://localhost:5173,http://127.0.0.1:5173,https://jouft.com,https://www.jouft.com,https://api.jouft.com"
db_name                 = "valueai"
db_username             = "valueai"
db_password             = "replace-me"
brand_accept_score      = 78
brand_accept_score_low  = 70
brand_gap_min           = 8
gpt_item_profile_enabled = true
gpt_item_profile_provider_order = "hybrid,gemini,openai"
gpt_item_profile_model = "gpt-5"
gpt_item_profile_gemini_model = "gemini-2.5-flash"
gpt_item_profile_timeout_s = 120
gpt_item_profile_max_images = 6
gpt_item_profile_image_detail = "auto"
gpt_item_profile_reasoning_effort = "low"
gpt_item_profile_vertex_search_enabled = false
gpt_item_profile_vertex_search_project_id = ""
gpt_item_profile_vertex_search_location = "global"
gpt_item_profile_vertex_search_model = "gemini-2.5-flash"
gpt_item_profile_vertex_search_datastore = ""
gpt_item_profile_vertex_search_access_token = ""
gpt_item_profile_vertex_search_max_results = 10
openai_api_key          = "replace-me"
gemini_api_key          = "replace-me"
photoroom_api_key       = "replace-me"
image_staging_photoroom_enabled = true
photoroom_background_color = "#FFFFFF"
photoroom_output_format = "jpg"
photoroom_output_size   = "full"
stripe_secret_key       = "replace-me"
stripe_publishable_key  = "replace-me"
google_places_api_key   = "replace-me"
shippo_api_key          = "replace-me"
shippo_parcel_weight_oz = 32
shippo_flat_rate_enabled = true
shippo_flat_rate_amount = "6.49"
shippo_flat_rate_currency = "USD"
shippo_flat_rate_max_weight_oz = 32
shippo_default_contact_email = "admin@jouft.com"
shippo_default_contact_phone = "+10000000000"
