{
  "expo": {
    "name": "JOUFT",
    "slug": "valueai-mobile",
    "scheme": "com.jouft.app.dev",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jouft.app.dev",
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.jouft.app"
        ]
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "fb",
          "fbapi",
          "fbauth2",
          "fbshareextension"
        ]
      }
    },
    "android": {
      "package": "com.jouft.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "monochromeImage": "./assets/app-icon-monochrome.png",
        "backgroundColor": "#4a161b"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      ["react-native-share", { "ios": ["fb"], "android": ["com.facebook.katana", "com.pinterest"] }],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Jouft to take photos of items for your listings.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Jouft to take photos of items for your listings.",
          "photosPermission": "Allow Jouft to select product photos for your listings.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.jouft.app",
          "enableGooglePay": true
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.jouft.com",
      "clerkPublishableKey": "pk_test_ZmlybS1taW5rLTM1LmNsZXJrLmFjY291bnRzLmRldiQ",
      "eas": {
        "projectId": "9fea2985-7a8a-477e-ae73-335fdcb4a048"
      }
    },
    "owner": "leavethemessage"
  }
}
