{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.jouft.com",
        "EXPO_PUBLIC_LISTING_AGENT_ENABLED": "true",
        "EXPO_PUBLIC_ASSISTANT_CONVERSATIONS_ENABLED": "true"
      },
      "autoIncrement": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testing": {
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.jouft.com",
        "EXPO_PUBLIC_LISTING_AGENT_ENABLED": "true",
        "EXPO_PUBLIC_ASSISTANT_CONVERSATIONS_ENABLED": "true"
      }
    }
  },
  "submit": {
    "testing": {
      "ios": {
        "ascAppId": "6791465341"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6791465341"
      }
    }
  }
}
