# Local development only. These values are bundled and are NOT secrets.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_DEVELOPMENT_KEY
EXPO_PUBLIC_LISTING_AGENT_ENABLED=true
EXPO_PUBLIC_ASSISTANT_CONVERSATIONS_ENABLED=true

# Configure these in EAS "preview" environment for the staging build profile.
# JOUFT_STAGING_API_URL=https://YOUR-STAGING-API
# JOUFT_STAGING_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_STAGING_KEY

# Configure in EAS "production" environment.
# JOUFT_PRODUCTION_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_KEY
# Never put Clerk secret keys or Stripe secret keys in the mobile app.
