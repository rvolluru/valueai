{
  "cli": { "version": ">= 14.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "development", "EXPO_PUBLIC_LISTING_AGENT_ENABLED": "true", "EXPO_PUBLIC_ASSISTANT_CONVERSATIONS_ENABLED": "true" }
    },
    "staging": {
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "staging", "EXPO_NO_DOTENV": "1", "EXPO_PUBLIC_LISTING_AGENT_ENABLED": "true", "EXPO_PUBLIC_ASSISTANT_CONVERSATIONS_ENABLED": "true" }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_ENV": "production", "EXPO_NO_DOTENV": "1", "EXPO_PUBLIC_LISTING_AGENT_ENABLED": "true", "EXPO_PUBLIC_ASSISTANT_CONVERSATIONS_ENABLED": "true" }
    }
  },
  "submit": {
    "staging": { "ios": { "ascAppId": "6791465341" } },
    "production": { "ios": {} }
  }
}
