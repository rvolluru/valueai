{
  "name": "jouft-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "ios": "node scripts/run-native.cjs ios",
    "android": "node scripts/run-native.cjs android",
    "web": "expo start --web",
    "eas:build:ios:development": "eas build --platform ios --profile development",
    "eas:build:android:development": "eas build --platform android --profile development",
    "eas:build:ios:staging": "node scripts/eas-release.cjs build ios staging",
    "eas:build:android:staging": "node scripts/eas-release.cjs build android staging",
    "eas:build:ios:production": "node scripts/eas-release.cjs build ios production",
    "eas:build:android:production": "node scripts/eas-release.cjs build android production",
    "eas:submit:ios:staging": "node scripts/eas-release.cjs submit ios staging",
    "eas:submit:ios": "node scripts/eas-release.cjs submit ios production",
    "eas:submit:android": "node scripts/eas-release.cjs submit android production"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo-google-fonts/bodoni-moda": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@stripe/stripe-react-native": "0.50.3",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-share": "^12.3.1"
  },
  "devDependencies": {
    "@expo/metro-config": "~54.0.16",
    "babel-preset-expo": "~54.0.10"
  }
}
